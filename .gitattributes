* text=auto
*.cs text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
# Large source assets; Git LFS must be installed before adding these.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
# Unity writes YAML with trailing spaces (e.g. "userData: "); exempt serialized assets from whitespace checks.
*.meta -whitespace
*.unity -whitespace
*.prefab -whitespace
*.asset -whitespace
*.mat -whitespace
*.anim -whitespace
*.controller -whitespace
